// =========================================================
// Meevo Sales Playbook - Data backend (Google Apps Script)
//
// ONE-TIME SETUP
//   1. script.google.com > New project. Paste this whole file. Save.
//   2. Function dropdown > "setup" > Run. Approve access.
//      Creates the spreadsheet "Meevo Sales Playbook Data" in your Drive
//      with tabs Links, NeedsInput, Owners, Changelog, Settings (all pre-filled
//      from the current playbook) and logs its URL.
//   3. Deploy > New deployment > Web app. Execute as: Me. Who has access: Anyone.
//      Copy the /exec URL into PLAYBOOK_API at the bottom of index.html.
//
// HOW IT WORKS
//   Every tab is served as JSON. Row 1 is the header; each row becomes an object.
//   Add a new tab any time and it is available at once:
//     GET ?action=all            -> { ok, sheetUrl, tabs: { Links:[...], NeedsInput:[...], ... } }
//     GET ?tab=Links             -> { ok, tab:"Links", rows:[...] }
//   Tabs whose name starts with "_" are private and never served.
//
// TABS THE PLAYBOOK READS
//   Links      id | section | label | url | notes      -> fixes any link on the page by id
//   NeedsInput id | section | item | owner | status | resolution
//              status: open (default) | done (shows resolution as a normal callout,
//              or removes the callout if resolution is blank) | hidden
//   Owners     section | owner                         -> rebuilds the owners table
//   Changelog  date | change | owner                   -> rebuilds the change log
// =========================================================

var SPREADSHEET_NAME = 'Meevo Sales Playbook Data';

function doGet(e) {
  var p = (e && e.parameter) || {};
  try {
    var ss = getSpreadsheet();
    if (p.tab) {
      var sh = ss.getSheetByName(p.tab);
      if (!sh || p.tab.charAt(0) === '_') return json({ ok:false, error:'Unknown tab: ' + p.tab });
      return json({ ok:true, tab:p.tab, rows: readTab(sh) });
    }
    if (p.action === 'all') {
      var tabs = {};
      ss.getSheets().forEach(function (sh) { if (sh.getName().charAt(0) !== '_') tabs[sh.getName()] = readTab(sh); });
      return json({ ok:true, sheetUrl: ss.getUrl(), tabs: tabs });
    }
    return json({ ok:true, status:'Meevo Playbook data backend is live.', sheetUrl: ss.getUrl(),
      tabs: ss.getSheets().map(function (sh) { return sh.getName(); }) });
  } catch (err) { return json({ ok:false, error:String(err && err.message || err) }); }
}

function setup() {
  var ss = getSpreadsheet();
  Logger.log('Playbook data sheet ready: ' + ss.getUrl());
}

// ---------- storage ----------
function getSpreadsheet() {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty('SHEET_ID'), ss = null;
  if (id) { try { ss = SpreadsheetApp.openById(id); } catch (e) { ss = null; } }
  if (!ss) { ss = SpreadsheetApp.create(SPREADSHEET_NAME); props.setProperty('SHEET_ID', ss.getId()); }
  seedTabs(ss);
  return ss;
}

function seedTabs(ss) {
  var first = ss.getSheets()[0];
  ensureTab(ss, 'Links',      ['id','section','label','url','notes'], SEED_LINKS, first);
  ensureTab(ss, 'NeedsInput', ['id','section','item','owner','status','resolution'], SEED_NEEDS);
  ensureTab(ss, 'Owners',     ['section','owner'], SEED_OWNERS);
  ensureTab(ss, 'Changelog',  ['date','change','owner'], SEED_CHANGES);
  ensureTab(ss, 'Settings',   ['key','value'], [['notes','Any tab you add here is served as JSON automatically. Row 1 = headers. Tabs starting with _ are private.']]);
}

function ensureTab(ss, name, headers, seed, reuse) {
  var sh = ss.getSheetByName(name);
  if (!sh) sh = (reuse && reuse.getName() === 'Sheet1') ? reuse.setName(name) : ss.insertSheet(name);
  if (sh.getLastRow() === 0) {
    sh.appendRow(headers); sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, headers.length).setFontWeight('bold');
    if (seed && seed.length) sh.getRange(2, 1, seed.length, headers.length).setValues(seed);
    sh.autoResizeColumns(1, headers.length);
  }
}

function readTab(sh) {
  var last = sh.getLastRow(), lastCol = sh.getLastColumn();
  if (last < 2 || lastCol < 1) return [];
  var vals = sh.getRange(1, 1, last, lastCol).getValues();
  var headers = vals[0].map(function (h) { return String(h || '').trim(); });
  var out = [];
  for (var r = 1; r < vals.length; r++) {
    var row = vals[r], obj = {}, empty = true;
    for (var c = 0; c < headers.length; c++) {
      if (!headers[c]) continue;
      var v = row[c];
      if (v instanceof Date) v = Utilities.formatDate(v, Session.getScriptTimeZone(), 'yyyy-MM-dd');
      obj[headers[c]] = v === null || v === undefined ? '' : v;
      if (v !== '' && v !== null) empty = false;
    }
    if (!empty) out.push(obj);
  }
  return out;
}

function json(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }

